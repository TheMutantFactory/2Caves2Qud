; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

run/max_fps=60

config/name="2Caves2Qud"
run/main_scene="res://Menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Shared="*res://Shared.gd"
QUD="*res://QUD.gd"
Controls="*res://Controls.gd"
SpellDB="*res://SpellDB.gd"
Campaign="*res://Campaign.gd"
Artifacts="*res://Artifacts.gd"
Audio="*res://Audio.gd"
Players="*res://mp/Players.gd"
Net="*res://net/SteamNet.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
